# Only what the function and the page need are deployed.
#
# src/ IS required -- api/harness.py imports the shipped modules rather than
# reimplementing them. demo/ is public but the function does not read it.
.git/
bob_sessions/
tests/
demo/
# tools/ is a local build step: it reduces bob_sessions/ to public/provenance.json,
# which is committed. Nothing at runtime reads it, and bob_sessions/ is not deployed
# here anyway, so it could not re-derive the summary even if something asked it to.
tools/
